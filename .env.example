# - DATABASE CONFIGURATION
# Local Docker: DB_HOST=db
# AWS EC2: DB_HOST=ip-publica-aws
DB_USER=user
DB_PASSWORD=password
DB_HOST=db
DB_PORT=5432
DB_NAME=db_name

# - SECURITY & ENCRYPTION
# Fernet Key for DNI encryption
FERNET_KEY=fernet-key
HASH_PEPPER=secret_pepper
# M2M Secret Key for Ecoparks
API_KEY_ECOPARQUE=m2m-key

# - JWT SETTINGS
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# - INFRASTRUCTURE (LOGGER)
# Local: LOGGER_HOST=logger
LOGGER_HOST=logger
LOGGER_PORT=5000

# - GENERAL APP SETTINGS
DEBUG=True
PROJECT_NAME="FemVerd API"
VERSION=1.0.0